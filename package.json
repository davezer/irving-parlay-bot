{
  "name": "irving-parlay-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Discord submission bot for the Irving Champions League weekly parlay.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "register": "tsx scripts/register-commands.ts"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^16.4.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
